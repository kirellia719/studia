# Kết nối MongoDB (Atlas hoặc local)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>

PORT=5000
NODE_ENV=development

# Bắt buộc; dùng chuỗi ngẫu nhiên dài, không dùng giá trị mặc định
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Danh sách origin được phép, phân tách bằng dấu phẩy.
# Bỏ trống sẽ dùng mặc định trong config/cors.js
CORS_ORIGINS=http://localhost:5173
