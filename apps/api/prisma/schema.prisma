generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  email    String @unique
  password String
  avatar    String?

  role Role @default(STUDENT)

  studentCode String? @unique

  courses          Course[]
  enrollments      Enrollment[]
  lessonProgresses LessonProgress[]
  quizAttempts     QuizAttempt[]

  // Soft delete
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isDelete])
  @@index([role, isDelete])
}

model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  teacherId String @db.ObjectId
  teacher   User   @relation(fields: [teacherId], references: [id])

  title       String
  description String?
  thumbnail   String?

  // Giá khóa học, đơn vị: nghìn đồng
  // 0 = miễn phí
  // 299 = 299.000 VNĐ
  // 599 = 599.000 VNĐ
  // 1200 = 1.200.000 VNĐ
  price Int @default(0)

  // Thời hạn khóa học, đơn vị: tháng
  // Ví dụ: 1, 3, 6, 12
  durationMonths Int @default(6)

  // true = mở
  // false = đóng
  status Boolean @default(true)

  lessons     Lesson[]
  enrollments Enrollment[]

  // Soft delete
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([isDelete])
  @@index([teacherId, isDelete])
}

model Lesson {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  title       String
  description String?

  // URL hoặc path của video
  video String?

  // Thời lượng video, đơn vị: giây
  duration Int?

  // Thứ tự bài học trong khóa học
  order Int

  // true  = miễn phí
  // false = cần tham gia khóa học
  isFree Boolean @default(false)

  documents  LessonDocument[]
  progresses LessonProgress[]
  quiz       Quiz?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([courseId, order])
}

model LessonDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  name     String
  url      String
  mimeType String
  size     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model Enrollment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id])

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id])

  enrolledAt DateTime @default(now())
  expiresAt  DateTime

  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([expiresAt])
}

model LessonProgress {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id])

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  // null = chưa hoàn thành
  // có giá trị = đã hoàn thành
  completedAt DateTime?

  // Lần cuối học sinh truy cập bài học
  lastAccessedAt DateTime @default(now())

  // Tiến độ xem video (giây), dùng để tính hoàn thành
  // và cho học sinh xem tiếp trên thiết bị khác.
  videoPositionSeconds Int @default(0)
  videoDurationSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

// ==========================================
// Quiz (trắc nghiệm ôn tập)
// Mỗi bài học có tối đa 1 đề.
// ==========================================

model Quiz {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lessonId String @unique @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  title       String
  description String?

  // Điểm đạt, đơn vị phần trăm (0 - 100)
  passingScore Int @default(70)

  // false = giáo viên đang soạn, học sinh không thấy đề
  isPublished Boolean @default(false)

  // Bắt buộc đạt đề này thì bài học mới được tính hoàn thành
  requiresPassForCompletion Boolean @default(false)

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model Question {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quizId String @db.ObjectId
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  content     String
  explanation String?

  order   Int
  options QuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, order])
}

model QuestionOption {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  questionId String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id])

  content   String
  isCorrect Boolean @default(false)

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId, order])
}

// ==========================================
// Lượt làm bài của học sinh
// Đáp án được chụp lại tại thời điểm nộp bài
// để xem lại đúng nội dung dù đề bị sửa sau đó.
// ==========================================

model QuizAttempt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quizId String @db.ObjectId
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id])

  startedAt   DateTime  @default(now())

  // null = đang làm
  submittedAt DateTime?

  // Điểm phần trăm, chỉ có khi đã nộp
  score         Int?
  correctCount  Int @default(0)
  totalQuestions Int

  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, studentId])
  @@index([studentId, submittedAt])
}

model QuizAnswer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  attemptId String      @db.ObjectId
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id])

  questionId String
  order      Int

  // Ảnh chụp nội dung tại thời điểm nộp bài
  questionContent String

  selectedOptionId String?
  selectedContent  String?

  correctOptionId String
  correctContent  String

  explanation String?
  isCorrect   Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}
